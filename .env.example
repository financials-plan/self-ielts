# Database: Local SQLite file for dev, Turso libsql:// URL for free Cloud deploy
DATABASE_URL=file:./data/ielts.db
DATABASE_AUTH_TOKEN=

# Better Auth (generate 32+ random chars or 64 hex chars)
BETTER_AUTH_SECRET=replace-with-random-64-char-hex-secret
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# AES-256-GCM encryption key for optional cloud-synced BYOK API keys (64 hex chars)
BYOK_ENCRYPTION_KEY=replace-with-random-64-char-hex-key

# Optional: Free Google OAuth (leave blank to use Email + Password)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional (Phase 6): Vercel Blob Free Storage token for cloud Speaking audio
BLOB_READ_WRITE_TOKEN=
