# Database:
# - Local dev: leave as file:./data/ielts.db (auto-migrates 14 tables & 435 lessons on first run)
# - Vercel 0 VND (Recommended): leave DATABASE_URL unset and attach a Vercel Private Blob store (BLOB_READ_WRITE_TOKEN)
# - Optional Turso cloud DB: set DATABASE_URL=libsql://... and DATABASE_AUTH_TOKEN=...
DATABASE_URL=file:./data/ielts.db
DATABASE_AUTH_TOKEN=

# Better Auth (generate 32+ random chars or 64 hex chars)
BETTER_AUTH_SECRET=replace-with-random-64-char-hex-secret
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# AES-256-GCM encryption key for optional cloud-synced BYOK API keys (64 hex chars or 32-byte base64)
BYOK_ENCRYPTION_KEY=replace-with-random-64-char-hex-key

# Optional: Free Google OAuth (leave blank to use Email + Password)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Vercel Private Blob Store token (persists SQLite snapshot & Speaking audio on Vercel Hobby 0 VND)
BLOB_READ_WRITE_TOKEN=
